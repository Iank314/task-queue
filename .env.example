POSTGRES_DB=taskqueue
POSTGRES_USER=your_user
POSTGRES_PASSWORD=your_password
DATABASE_URL=postgresql+asyncpg://your_user:your_password@postgres/taskqueue

# Crash recovery (optional -- defaults shown).
# LEASE_DURATION_SECONDS: how long a claimed job may run before its worker must
#   renew the lease; if it lapses the job is presumed abandoned and reclaimed.
# REAPER_INTERVAL_SECONDS: how often each worker sweeps for expired leases.
LEASE_DURATION_SECONDS=30
REAPER_INTERVAL_SECONDS=15
